# Copy this file to .env and fill in the values. Never commit .env.

# From @BotFather in Telegram: the token of @ArtistCommissionsBoardBot
TELEGRAM_BOT_TOKEN=

# From platform.claude.com -> API keys
ANTHROPIC_API_KEY=

# From console.upstash.com -> your Redis database -> REST API
# (Vercel's Upstash integration may name them KV_REST_API_URL / KV_REST_API_TOKEN; both work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any long random string, for example from: openssl rand -hex 32
# Telegram sends it with every update so the bot can tell real updates from fake ones.
TELEGRAM_WEBHOOK_SECRET=
